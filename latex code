\section{Inclusion-Exclusion Principle}

% Slide 15: Inclusion-Exclusion Principle - Concept & Formula
\begin{frame}{Inclusion-Exclusion Principle}{Concept \& Formulations}

    \Large \textbf{Principle of Inclusion-Exclusion (PIE)} \normalsize
    \vspace{0.3cm}

    \begin{block}{Definition}
        A counting technique to compute the number of elements in the union of multiple sets without overcounting elements in their intersections.
    \end{block}

    \vspace{0.2cm}

    \begin{block}{Two-Set Formula}
        For any two finite sets $A$ and $B$:
        \[
            |A \cup B| = |A| + |B| - |A \cap B|
        \]
    \end{block}

    \begin{block}{Three-Set Formula}
        For any three finite sets $A$, $B$, and $C$:
        \[
            |A \cup B \cup C| = |A| + |B| + |C| - |A \cap B| - |B \cap C| - |A \cap C| + |A \cap B \cap C|
        \]
    \end{block}

\end{frame}






% Slide 16: Inclusion-Exclusion Principle - Data Science Example
\begin{frame}{Inclusion-Exclusion Principle}{AI / Data Science Example}

    \Large \textbf{Example: Data Preprocessing \& Cleaning} \normalsize
    \vspace{0.3cm}

    \begin{exampleblock}{Problem Scenario}
        A audio dataset of $1000$ recordings is checked for noise artifacts:
        \begin{itemize}
            \item Set $A$ (High Noise): $|A| = 300$
            \item Set $B$ (Clipping Artifacts): $|B| = 200$
            \item Set $A \cap B$ (Both High Noise and Clipping): $|A \cap B| = 80$
        \end{itemize}
    \end{exampleblock}

    \vspace{0.2cm}

    \begin{block}{Calculation}
        Total unique corrupted audio files ($|A \cup B|$):
        \[
            |A \cup B| = |A| + |B| - |A \cap B| = 300 + 200 - 80 = 420
        \]
        Total clean audio files remaining = $1000 - 420 = 580$.
    \end{block}

\end{frame}

