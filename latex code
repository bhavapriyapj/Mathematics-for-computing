\begin{frame}{Types of Sets}{Hasse Diagram}

    \textbf{\Large 12. Hasse Diagram}
    \vspace{0.2cm}

    \begin{block}{Definition}
        A visual representation of a finite partially ordered set (poset) that eliminates redundant reflexive self-loops and transitive edges.
    \end{block}

    \begin{columns}[c]
        \begin{column}{0.50\textwidth}
            \begin{block}{Core Properties}
                \begin{itemize}
                    \item Directed upward (larger elements higher).
                    \item Omits self-loops ($x \le x$).
                    \item Omits transitive edges ($a \le b \land b \le c \implies a \le c$).
                \end{itemize}
            \end{block}
        \end{column}

        \begin{column}{0.46\textwidth}
